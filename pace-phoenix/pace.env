# PACE Phoenix site configuration for the GRN pipeline.
#
# SOURCE THIS FILE before running the pipeline or submitting jobs:
#     source pace.env
#
# Or edit the values in place.  Every script in this bundle reads only these
# variables plus $PACE_ROOT / $SCAGA_REPO.

# ---------------------------------------------------------------------------
# WORKSPACE
# ---------------------------------------------------------------------------
# Put the workspace on scratch (15 TB, not backed up, purged after 60 idle days)
# or on your group's project storage (backed up).  NOT home: 20 GB quota and the
# all-cells matrix alone is 2.7 GB.
# Examples:
#   /storage/scratch1/<gtuser>/pbmc-grn
#   /storage/home/hcoda1/<n>/<gtuser>/pbmc-grn
export PACE_ROOT="${PACE_ROOT:-$HOME/scratch/pbmc-grn}"

# Where the data/ dir lives (defaults to $PACE_ROOT/data).  Can be a symlink to
# project storage if scratch is too small.
export PACE_DATA="${PACE_DATA:-$PACE_ROOT/data}"

# Raw 10x downloads (defaults to $PACE_ROOT/raw)
export PACE_RAW="${PACE_RAW:-$PACE_ROOT/raw}"

# scSAGA checkout produced by envs/03_patch_scsaga.py
export SCAGA_REPO="${SCAGA_REPO:-$PACE_ROOT/tools/scSAGA}"

# ---------------------------------------------------------------------------
# SLURM / PACE ACCOUNT
# ---------------------------------------------------------------------------
# Your charge account (MAM).  Find it with:  pace-quota
# Format looks like  GT-<pi-username>-<something>  or  paceship-<group>_<n>
export PACE_ACCOUNT="${PACE_ACCOUNT:-}"

# embers  = free, preemptible backfill queue. Good for the download and all the
#           short steps. Long un-preempted runs should use inferno (spends
#           credits) or checkpoint.
# inferno = paid/credit queue, not preempted.
export PACE_QOS="${PACE_QOS:-embers}"

# Leave empty unless the queue docs for your account require a specific
# partition.  Phoenix node classes are chosen automatically by the scheduler.
export PACE_PARTITION="${PACE_PARTITION:-}"

# ---------------------------------------------------------------------------
# CONDA ENVIRONMENTS  (created by envs/02_setup_envs.sh)
# ---------------------------------------------------------------------------
export SC_ENV="${SC_ENV:-scmint}"     # python 3.12: scSAGA, prep, imputation, eval
export GRN_ENV="${GRN_ENV:-grn39}"    # python 3.9 : arboreto 0.1.6 + dask 2021.10

# ---------------------------------------------------------------------------
# GRN PARALLELISATION
# ---------------------------------------------------------------------------
# Arboreto GRNBoost2 takes a pre-built dask Client, so worker count is a runtime
# setting, not a code change.
#
#   GRN_WORKERS * GRN_THREADS_PER_WORKER must equal the job's --cpus-per-task.
#
#   MEMORY scales with worker COUNT (not CPUs), because Arboreto broadcasts the
#   TF matrix to every worker: n_TFs x n_cells x 4 bytes
#     816 TFs x 20,059 cells = 65 MB per worker  -> 16 workers = ~1.0 GB
#   plus ~150-250 MB per worker for the interpreter/numpy/sklearn/dask.
#   Rough sizing for the unpaired run:  --mem = workers x 0.30 GB + ~1 GB
#       8 workers -> 32G      16 workers -> 64G  (default)      20 workers -> 96G
#   PACE caps a node at ~192 GB, so 20 workers is the practical maximum.
#
#   Measured wall time on the real matrix shape (2,000 cells x 400 genes, real 10k
#   multiome RNA, seed 666 -- identical 21,998 edges at every worker count):
#       1 worker   92.0 s
#       2 workers  47.2 s   (1.95x)
#       4 workers  25.2 s   (3.65x)
#       8 workers  18.6 s   (4.95x)
#   Diminishing returns past ~8-16; GRNBoost2 splits work per TARGET GENE and the
#   last gene to finish bounds the wall time.  Going 8 -> 16 roughly halves the
#   time again but doubles the memory.
export GRN_WORKERS="${GRN_WORKERS:-16}"
export GRN_THREADS_PER_WORKER="${GRN_THREADS_PER_WORKER:-1}"

# Multi-node worker job sizing (only used with GRN_JOBQUEUE=1)
export GRN_SLURM_CORES="${GRN_SLURM_CORES:-16}"
export GRN_SLURM_MEMORY="${GRN_SLURM_MEMORY:-32GB}"

# MULTI-NODE (optional): set GRN_JOBQUEUE=1 to have the GRN step submit its own
# worker jobs to SLURM (one job per --jobqueue-workers, each --slurm-cores).
# Requires dask-jobqueue (installed by 02_setup_envs.sh) and the GRN job must run
# on a node that can call sbatch.
export GRN_JOBQUEUE="${GRN_JOBQUEUE:-0}"
export GRN_NODE_WORKERS="${GRN_NODE_WORKERS:-2}"

# Or attach to an existing scheduler you started yourself:
#   dask-scheduler --port 8786
#   dask-worker tcp://<node>:8786 --nthreads 8
# then export GRN_SCHEDULER=tcp://<node>:8786
export GRN_SCHEDULER="${GRN_SCHEDULER:-}"

# Which workflow: unpaired (multiome 10k RNA x external 10k ATAC v1.1)
#              or paired   (multiome 10k RNA x its own ATAC)
export PACE_EXPERIMENT="${PACE_EXPERIMENT:-unpaired}"
